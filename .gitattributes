# Normalise line endings so diffs and checksums are stable across platforms.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary artefacts that must never be line-ending converted.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
