{
  "name": "@complisme/api",
  "version": "1.0.0",
  "private": true,
  "description": "CompliSME REST API (Fastify): assess, generate, scan, frameworks, rules, auth, billing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "dev": "tsx watch src/dev.ts",
    "start": "node dist/main.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@complisme/core": "workspace:*",
    "@complisme/frameworks": "workspace:*",
    "@complisme/generator": "workspace:*",
    "@complisme/llm": "workspace:*",
    "@complisme/scanner": "workspace:*",
    "@complisme/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}