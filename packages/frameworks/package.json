{
  "name": "@complisme/frameworks",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source regulatory framework definitions (EU AI Act, CSRD/ESRS, GDPR, e-invoicing).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "definitions"],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/copy-definitions.js",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@complisme/shared": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}