{
  "name": "@complisme/scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Codebase scanner: detects PII, retention, consent, logging and AI API usage and maps them to GDPR / EU AI Act articles.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@complisme/core": "workspace:*",
    "@complisme/frameworks": "workspace:*",
    "@complisme/shared": "workspace:*",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}