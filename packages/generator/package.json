{
  "name": "@complisme/generator",
  "version": "1.0.0",
  "private": true,
  "description": "Document generation: EU AI Act Annex IV, CSRD report, GDPR ROPA/DPIA, e-invoicing validation report. HTML, PDF and DOCX.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@complisme/core": "workspace:*",
    "@complisme/frameworks": "workspace:*",
    "@complisme/shared": "workspace:*",
    "jszip": "^3.10.1",
    "puppeteer": "^23.11.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}