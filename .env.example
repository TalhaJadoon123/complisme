# ---------------------------------------------------------------------------
# CompliSME — environment template. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
COMPLISME_TELEMETRY=off

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Signs session/API tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-development-secret-please-32-bytes-min
# Comma separated list of static API keys (self-hosted / integration use)
API_STATIC_KEYS=

# Database (leave empty to run the API on the in-memory store)
DATABASE_URL=postgres://complisme:complisme@localhost:5432/complisme

# LLM providers (BYOK). Leave all empty to run fully offline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Which provider to use when several keys are present: openai | anthropic | ollama
LLM_PROVIDER=

# PDF rendering (optional). Without it, generation returns HTML + DOCX only.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_DOWNLOAD=true

# Billing (optional). Without keys, the API runs in "no billing" mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# GitHub issue publishing (optional). `complisme publish` files compliance gaps
# as issues. The token needs issues:write on the target repository only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
# Only for GitHub Enterprise; leave empty for github.com
GITHUB_API_URL=

# Rate limiting. A global budget plus tighter per-route budgets on the four
# expensive operations (AI, scan, document generation, publishing).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_AI=20
RATE_LIMIT_SCAN=10
RATE_LIMIT_GENERATE=15
RATE_LIMIT_PUBLISH=10
RATE_LIMIT_PREVIEW=20

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=CompliSME
